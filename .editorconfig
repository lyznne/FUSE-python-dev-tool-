# EditorConfig helps maintain consistent coding styles

root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
end_of_line = lf
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4
max_line_length = 88  # align with Ruff/Black default

[*.json]
indent_size = 2

[*.yml]
indent_size = 2
